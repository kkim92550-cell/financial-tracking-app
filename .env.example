# Copy to .env (git-ignored) and fill in. Find both values in the Supabase dashboard under
# Project Settings → API. Use the publishable / anon key only — never the service-role key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Optional
# PORT=4310
# HOST=127.0.0.1
# TALLY_STORE=memory      # run offline with an in-memory store and a demo account
